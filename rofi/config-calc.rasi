* {
    g-spacing: 10px;
    g-margin: 0;
    b-color: #000000cc;
    fg-color: #ffffff;
    fgp-color: #888888FF;
    b-radius: 10px;
    g-padding: 8px;
    hl-color:#ff0088;
    //highlight: bold italic underline #fb4934;
    highlight: italic underline #ff0088;
    hlt-color: #000000cc;
    alt-color: #111111cc;
    wbg-color: #000000cc;
    // wbg-color: #201B14d0;
    w-border: 2px solid;
    w-border-color: #c0ff1eff;
    //w-border-color: #ff0088ff;
    w-padding: 12px;
}

configuration {
    //font: "Maple Mono NF CN bold 18";
    font: "ocr a 20";
    modi: "calc";
    show-icons: true;
    sort: false;
    //sorting-method:"fzf";
    //display-drun: " ";
    display-calc: "->";
    //display-list: "";
    calc {
	no-bold: false;
	hint-welcome: "Qalc";
	hint-result: "=";
	automatic-save-to-history: true;
        calc-command-history: true;
	no-persist-history: false;
	no-sort: true;
	no-show-match: true;
	terse: true;
	calc-error-color: "Red";
	reuse-result:  true;
	calc-command: "echo -n '{result}' | wl-copy";
    }
}

listview {
    columns: 1;
    lines: 5;
    fixed-height: false;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

window {
    transparency: "real";
    width: 750px;
    //height: 300px;
    border-radius: @b-radius;
    background-color: @wbg-color;
    border: 4px solid;
    border-color: @w-border-color;
    padding: @w-padding;
}

prompt {
    text-color: @fg-color;
}

inputbar {
    //children: ["prompt", "listview", "entry"];
    children: ["prompt", "entry"];
    //children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "";
    text-color: @fg-color;
    placeholder-color: @fgp-color;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    //children: ["inputbar",  "message"];
    children: ["inputbar", "listview" ,  "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    border-color: @b-color;
    background-color: transparent;
    text-color: @fg-color;
}

element normal.normal {
	background-color: transparent;
	text-color: @fg-color;
}

element alternate.normal {
	//background-color: @alt-color;
    background-color: transparent;
	text-color: @fg-color;
}

element selected.active {
	background-color: @hl-color;
	text-color: @hlt-color;
}

element selected.normal {
	background-color: @hl-color;
	text-color: @hlt-color;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

element-text selected.normal {
    highlight: bold italic underline rgb(92, 11, 0);
    background-color: inherit;
    text-color:       inherit;
}


message {
    background-color: #ff0088;
    border: 0px solid;
}

textbox {
    highlight:  @highlight;
    text-color: @foreground;
}
